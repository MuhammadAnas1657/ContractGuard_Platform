# ==============================================================================
# ContractGuard-X Environment Configuration
# ==============================================================================

# Database: PostgreSQL (or SQLite via sqlite:///./contractguard.db)
DATABASE_URL=postgresql://postgres:hackathon@localhost:5432/hackathon

# Nebius Token Factory Cloud Runtime
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here

# NVIDIA Foundation Models on Nebius
NEMOTRON_SYNTHESIS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_VERIFIER_MODEL=nvidia/nemotron-mini-4b-instruct

# Frontend API URL
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
